#! /bin/sh

sed -e 's!BUILD_INSTALL_DIR="${BUILD_DIR}/src/libunix"!BUILD_INSTALL_DIR="${BUILD_DIR}/src/libwinucrt"!g' <configure >configure.win.tmp

XTRA=
if which lld >/dev/null 2>/dev/null ; then
  XTRA="LD=lld"
fi

lt_cv_sys_max_cmd_len=8192 ./configure.win.tmp $XTRA $*
cp src/Makevars src/Makevars.ucrt
